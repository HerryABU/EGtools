*.generated.cs

# -------- Test / coverage --------
[Tt]est[Rr]esult*/
*.testrun
*.trx
.coverage
.coveragexml
[Oo]verage/

# -------- IDE / editor --------
.vs/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln.iml
