*.swo
*~

# -------- Logs / temp / diagnostics --------
*.log
*.logs/
xc.log
__fd_*.txt
__inst_*.txt
__res_*.txt
__rt_*.txt
__ver_*.txt
rt_*.txt
rt_*.log
wer.log
