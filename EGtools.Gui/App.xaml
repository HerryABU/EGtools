<Application
    x:Class="EGtools.Gui.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EGtools.Gui">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardBg" Color="#F6F6F8" />
                    <SolidColorBrush x:Key="CardBorder" Color="#E2E2E8" />
                    <SolidColorBrush x:Key="DropBg" Color="#FBFBFD" />
                    <SolidColorBrush x:Key="DropBorder" Color="#C9C9D2" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardBg" Color="#232327" />
                    <SolidColorBrush x:Key="CardBorder" Color="#383842" />
                    <SolidColorBrush x:Key="DropBg" Color="#2A2A30" />
                    <SolidColorBrush x:Key="DropBorder" Color="#454552" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
