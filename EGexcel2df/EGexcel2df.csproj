<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EGexcel2df</AssemblyName>
    <RootNamespace>EGexcel2df</RootNamespace>
    <GenerateProgramFile>false</GenerateProgramFile>
    <Version>4.2.1</Version>
    <AssemblyVersion>4.2.1.0</AssemblyVersion>
    <FileVersion>4.2.1.0</FileVersion>
    <Company>HerryABU</Company>
    <Product>EGtools</Product>
    <Copyright>Copyright © 2026 HerryABU</Copyright>
    <!-- 发布目录不带符号文件：交付的是 Release，产物里不该混着 *.pdb。 -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The comparison engine lives in EGexcel2df.Engine. -->
    <ProjectReference Include="..\EGexcel2df.Engine\EGexcel2df.Engine.csproj" />
  </ItemGroup>

</Project>
