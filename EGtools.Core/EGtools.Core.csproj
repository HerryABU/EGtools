<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>EGtools.Core</RootNamespace>
    <AssemblyName>EGtools.Core</AssemblyName>
    <GenerateProgramFile>false</GenerateProgramFile>
    <Version>4.2.1</Version>
    <AssemblyVersion>4.2.1.0</AssemblyVersion>
    <FileVersion>4.2.1.0</FileVersion>
    <Company>HerryABU</Company>
    <Product>EGtools</Product>
    <Copyright>Copyright © 2026 HerryABU</Copyright>
  </PropertyGroup>
  <!-- EGtools.Core is now a thin SHARED library: only the logging seam
       (ForwardingWriter) lives here. The two processing engines were split out
       into EGpdf2excel.Engine (PDF -> Excel) and EGexcel2df.Engine
       (Excel -> change comparison), which both reference this project. -->
</Project>
