<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>EGtools.Core</RootNamespace>
    <AssemblyName>EGtools.Core</AssemblyName>
    <GenerateProgramFile>false</GenerateProgramFile>
    <!-- EmbeddedKernel 用函数指针（delegate* unmanaged）接收原生日志回调，需要 unsafe。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>4.2.1</Version>
    <AssemblyVersion>4.2.1.0</AssemblyVersion>
    <FileVersion>4.2.1.0</FileVersion>
    <Company>HerryABU</Company>
    <Product>EGtools</Product>
    <Copyright>Copyright © 2026 HerryABU</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared PDF text/geometry helpers (TextGeometry) need the same MuPDF
         engine the processing kernels use, so Core becomes the single home for
         the "read vector glyphs into words" logic reused by every kernel. -->
    <PackageReference Include="MuPDFCore" Version="2.0.1" />
  </ItemGroup>

  <!-- EGtools.Core is the SHARED library: the logging seam (ForwardingWriter)
       plus TextGeometry (MuPDF word/line-number extraction). The processing
       engines (EGpdf2excel.Engine, EGpdf2df.Engine) reference this project. -->
</Project>
