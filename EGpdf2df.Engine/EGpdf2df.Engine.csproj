<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>EGpdf2df.Engine</RootNamespace>
    <AssemblyName>EGpdf2df.Engine</AssemblyName>
    <GenerateProgramFile>false</GenerateProgramFile>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>HerryABU</Company>
    <Product>EGtools</Product>
    <Copyright>Copyright © 2026 HerryABU</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared seam: ForwardingWriter + TextGeometry (MuPDF word extraction). -->
    <ProjectReference Include="..\EGtools.Core\EGtools.Core.csproj" />
    <!-- MuPDF engine (same as the other EGtools kernels). -->
    <PackageReference Include="MuPDFCore" Version="2.0.1" />
    <!-- OpenCV: image registration (ORB + homography) and graphic diff (SSIM /
         absdiff). MIT-licensed, AGPL3-compatible. -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <!-- 原生 OpenCV 按**平台**分包：两个包**同时引用**是安全的 —— 它们的资产都在
         `runtimes/<rid>/native/` 下（且包内 build/*.props 只对 .NET Framework 生效），
         所以 `-r win-x64` 只带 OpenCvSharpExtern.dll、`-r linux-x64` 只带
         libOpenCvSharpExtern.so，互不污染。
         ⚠️ 漏了 linux-x64 的表现：发布"成功"，但产物里只有托管的 OpenCvSharp.dll，
         运行时第一次调 Cv2.* 就抛 DllNotFoundException（`EGpdf2df dev` 的图纸对齐
         与图形差异全靠 OpenCV，等于功能整体不可用）。
         ⚠️⚠️ **必须用 `.official.runtime.linux-x64`，不能用 `.runtime.linux-x64`**（2026-10-13 实测）：
         `.runtime.linux-x64` 只发过 4.10.0.20240717 一个版本，它是按 Ubuntu 20.04 时代
         (glibc 2.31) 构建的，**DT_NEEDED 钉死在旧 soname 上**（libtiff.so.5 / libtesseract.so.4 /
         libavcodec.so.58 / libopenjpeg.so.7 / libIlmImf-2_5.so.25 / libgtk-x11-2.0.so.0 …）。
         在 Ubuntu 24.04 上这些 soname 一个都不存在，`dotnet publish` **照样成功**（交叉发布
         看不出问题），但运行时 `dlopen` 直接失败：
             `The type initializer for 'OpenCvSharp.Internal.NativeMethods' threw an exception.`
         `.official.runtime.linux-x64` 4.13.0 在 24.04 上 74 个依赖全部可解析（实测）。
         ⚠️ 不要用 `OpenCvSharp4.runtime.ubuntu.22.04-x64`：只发过 4.6.0-snapshot，
         且 RID 是 `ubuntu.*` 而非通用的 `linux-x64`。
         ⚠️ 换版本必须**四处同步**（托管 + win + linux-x64 + linux-arm64），否则托管层与原生层符号对不上。
         ⚠️ arm64 的包名是**普通版** `OpenCvSharp4.runtime.linux-arm64`（**没有** official 版；
            实测其依赖基线也是新的：libtiff.so.6 / libtesseract.so.5 / libavcodec.so.60 /
            libgtk-3.so.0 —— 与 official.linux-x64 4.13 同批，Ubuntu 24.04 兼容）。 -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.linux-arm64" Version="4.13.0.20260627" />
    <!-- iText7: write the diff as a VECTOR PDF (preserve the original drawing's native
         vector content, then append a vector annotation layer). AGPL-3.0 — same license
         family as this project, so the combined work stays AGPL-3.0. -->
    <PackageReference Include="itext7" Version="9.8.0" />
    <!-- BouncyCastle adapter: iText 9.x 跨文档对象拷贝(CopyTo, 用于把基准页字体原样
         深拷贝进目标页)走 smart-mode 序列化器，需要加密哈希 → 必须显式引用非 FIPS 适配器。 -->
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.8.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Externalizable diff config (DPI, thresholds, registration, annotation). -->
    <Content Include="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
