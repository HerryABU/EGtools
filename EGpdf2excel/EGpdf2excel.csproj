<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EGpdf2excel</AssemblyName>
    <RootNamespace>EGpdf2excel</RootNamespace>
    <GenerateProgramFile>false</GenerateProgramFile>
    <Version>4.2.1</Version>
    <AssemblyVersion>4.2.1.0</AssemblyVersion>
    <FileVersion>4.2.1.0</FileVersion>
    <Company>HerryABU</Company>
    <Product>EGtools</Product>
    <Copyright>Copyright © 2026 HerryABU</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- The extraction engine lives in EGpdf2excel.Engine (MuPDF-backed). -->
    <ProjectReference Include="..\EGpdf2excel.Engine\EGpdf2excel.Engine.csproj" />
  </ItemGroup>

</Project>
