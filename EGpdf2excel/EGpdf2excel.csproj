<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EGpdf2excel</AssemblyName>
    <RootNamespace>EGpdf2excel</RootNamespace>
    <GenerateProgramFile>false</GenerateProgramFile>
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <Company>HerryABU</Company>
    <Product>EGtools</Product>
    <Copyright>Copyright © 2026 HerryABU</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- The extraction engine lives in EGtools.Core (MuPDF-backed). -->
    <ProjectReference Include="..\EGtools.Core\EGtools.Core.csproj" />
  </ItemGroup>

</Project>
